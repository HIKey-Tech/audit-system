# ────────────────────────────────────────────────────────────────────
# IAMS — Internal Audit Management Software
# Environment variable template. Copy to `.env` and fill in real values.
# Never commit `.env`. Only `DATABASE_URL` is strictly required to boot.
# ────────────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────────
APP_NAME=Internal Audit System
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
API_VERSION=v1

# ── Database (REQUIRED) ────────────────────────────────────────────
# SQL Server connection string. Format:
#   sqlserver://<host>:<port>;database=<db>;user=<user>;password=<pwd>;encrypt=true;trustServerCertificate=true
DATABASE_URL=sqlserver://localhost:1433;database=iams;user=sa;password=changeme;encrypt=true;trustServerCertificate=true

# ── JWT ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRES_IN=15
JWT_REFRESH_SECRET=replace-with-strong-random-secret
JWT_REFRESH_EXPIRES_IN=7

# ── OIDC ───────────────────────────────────────────────────────────
# Provider: 'azure_ad' (default) or 'generic'
OIDC_PROVIDER=azure_ad

# Azure AD (used when OIDC_PROVIDER=azure_ad)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
AZURE_AD_LOGOUT_URI=http://localhost:3000

# Generic OIDC (used when OIDC_PROVIDER=generic — Okta, Auth0, Keycloak, etc.)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
OIDC_SCOPES=openid profile email

# ── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TTL=3600

# ── Email (SMTP) ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@yourcompany.com

# ── Document Storage ───────────────────────────────────────────────
# Provider: 'local' (default), 'azure_blob', or 'aws_s3'
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# Azure Blob (used when STORAGE_PROVIDER=azure_blob)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=audit-documents

# ── Rate Limiting ──────────────────────────────────────────────────
# 15 minutes window, 100 requests per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Logging ────────────────────────────────────────────────────────
# Level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info
LOG_FORMAT=json

# ── Data Warehouse (used by Logging archive job + Predictive module) ──
DATA_WAREHOUSE_URL=
DATA_WAREHOUSE_API_KEY=
