# AZURE_STORAGE_CONTAINER=audit-documents

# ============================================================
# DATA WAREHOUSE
# ============================================================
DATA_WAREHOUSE_URL=
DATA_WAREHOUSE_API_KEY=

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
# Per-IP cap over the window. Behind the Next BFF proxy many users can share one
# source IP, and a single dashboard load fans out ~9 requests — keep this high.
RATE_LIMIT_MAX_REQUESTS=600
# Failed credential/OTP attempts per window (brute-force guard). Successful
# requests don't count, so legitimate users are never throttled here.
RATE_LIMIT_AUTH_MAX=10
# Dev convenience: turn rate limiting OFF in non-production only. This is IGNORED
# in production (NODE_ENV=production), where rate limiting is always enforced.
RATE_LIMIT_DISABLED=true

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=info
LOG_FORMAT=json

AWS_ACCESS_KEY_ID=AKIA5CKAIPADRYD4KXNH
AWS_SECRET_ACCESS_KEY=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 # Amazon S3 Secret Access Key
STORAGE_PROVIDER=aws_s3
AWS_REGION=eu-west-1
AWS_S3_BUCKET=iams-gbb-staging-documents
AWS_S3_PREFIX=staging
AWS_S3_SIGNED_URL_TTL_SECONDS=300
AWS_S3_FORCE_PATH_STYLE=false


# ── Two-factor authentication (2FA) ────────────────────────────────
# When true, local-password users must enrol in 2FA before gaining access.
MFA_MANDATORY=true
# Issuer name shown in authenticator apps (defaults to APP_NAME).
MFA_ISSUER=IAMS
MFA_CHALLENGE_TTL=5m
MFA_ENROLL_TTL=15m
MFA_EMAIL_OTP_TTL=10m
MFA_EMAIL_OTP_MAX_ATTEMPTS=5
MFA_BACKUP_CODE_COUNT=10
# 32-byte key (hex or base64) for AES-256-GCM encryption of TOTP secrets at rest.
# Generate with: openssl rand -base64 32 — falls back to JWT_SECRET if unset (dev only).
MFA_ENCRYPTION_KEY=FCS6eEGc4I7jONpp4lLKzZdI31XV/kk+QHFlKuqrbww=


# ── Cache ──────────────────────────────────────────────────────────
# Cache backend for hot read endpoints (e.g. dashboard analytics).
# 'redis' for shared/multi-instance deployments; 'memory' for local dev.
# If 'redis' but the server is unreachable, the app degrades to cache-misses
# (it never crashes) and keeps serving fresh data.
CACHE_DRIVER=memory

# ── Frontend / Password reset ──────────────────────────────────────
# Public base URL of the Next.js app — password-reset emails link here.
FRONTEND_URL=http://localhost:3001 #dont fprget set real nextjs url 
PASSWORD_RESET_TOKEN_TTL=30m