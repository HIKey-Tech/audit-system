// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ============================================================
// USER MODULE
// ============================================================

model User {
  id             String    @id @default(uuid())
  azure_oid      String? // Azure AD Object ID
  email          String    @unique
  email_verified Boolean   @default(false)
  first_name     String
  last_name      String
  display_name   String?
  avatar_url     String?
  phone          String?
  department     String?
  job_title      String?
  skills         String?   @db.NVarChar(Max) // JSON array of skill tags e.g. ["ISO 27001","ITGC"]
  max_concurrent_engagements Int? // per-auditor capacity cap; null falls back to the system default
  is_active      Boolean   @default(true)
  is_system_user Boolean   @default(false)
  is_super_admin Boolean   @default(false)
  last_login_at  DateTime?
  password_hash  String? // null for SSO-only users
  mfa_enabled     Boolean   @default(false)
  mfa_method      String? // 'totp' | 'email'
  mfa_totp_secret String? // AES-256-GCM encrypted base32 secret; null until TOTP enrolled
  mfa_enrolled_at DateTime?
  mfa_grace_until DateTime? // grace deadline; after this, mandatory 2FA hard-blocks login
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  user_roles        User_Role[]
  refresh_tokens    Refresh_Token[]
  password_reset_tokens Password_Reset_Token[]
  mfa_backup_codes  Mfa_Backup_Code[]
  mfa_email_otps    Mfa_Email_Otp[]
  audit_logs        Audit_Log[]
  notifications     Notification[]
  documents         Document[]
  document_versions Document_Version[]
  templates_created Document_Template[] @relation("TemplateCreatedBy")
  templates_updated Document_Template[] @relation("TemplateUpdatedBy")

  // Audit module back-relations
  universes_owned                 Audit_Universe[]         @relation("UniverseOwner")
  universes_created               Audit_Universe[]         @relation("UniverseCreatedBy")
  plans_created                   Audit_Plan[]             @relation("PlanCreatedBy")
  plans_approved                  Audit_Plan[]             @relation("PlanApprovedBy")
  engagements_led                 Audit_Engagement[]       @relation("EngagementLead")
  engagements_managed             Audit_Engagement[]       @relation("EngagementManager")
  engagements_as_auditee          Audit_Engagement[]       @relation("EngagementAuditee")
  engagements_created             Audit_Engagement[]       @relation("EngagementCreatedBy")
  working_papers_created          Audit_Working_Paper[]    @relation("WorkingPaperCreatedBy")
  working_papers_reviewed         Audit_Working_Paper[]    @relation("WorkingPaperReviewedBy")
  evidence_uploaded               Audit_Evidence[]         @relation("EvidenceUploadedBy")
  findings_as_auditee             Audit_Finding[]          @relation("FindingAuditee")
  findings_created                Audit_Finding[]          @relation("FindingCreatedBy")
  findings_closed                 Audit_Finding[]          @relation("FindingClosedBy")
  reports_created                 Audit_Report[]           @relation("ReportCreatedBy")
  follow_up_responses             Audit_Follow_Up[]        @relation("FollowUpResponseBy")
  follow_ups_verified             Audit_Follow_Up[]        @relation("FollowUpVerifiedBy")
  checklists_tested               Audit_Checklist[]        @relation("ChecklistTestedBy")
  risk_categories_created         Risk_Category[]          @relation("RiskCategoryCreatedBy")
  risks_owned                     Risk_Register[]          @relation("RiskOwner")
  risks_created                   Risk_Register[]          @relation("RiskCreatedBy")
  risk_assessments_done           Risk_Assessment[]        @relation("RiskAssessedBy")
  workflow_approvals_submitted    Workflow_Approval[]      @relation("WorkflowApprovalSubmittedBy")
  workflow_approval_steps         Workflow_Approval_Step[] @relation("WorkflowApprovalStepApprover")
  workflow_assignments            Workflow_Assignment[]    @relation("WorkflowAssignmentUser")
  workflow_assignments_made       Workflow_Assignment[]    @relation("WorkflowAssignmentAssignedBy")
  workflow_escalations            Workflow_Escalation[]    @relation("WorkflowEscalationEscalatedTo")
  escalation_policies_created     Escalation_Policy[]      @relation("EscalationPolicyCreatedBy")
  requests_initiated              Workflow_Request[]        @relation("WorkflowRequestInitiator")
  request_steps                   Workflow_Request_Step[]   @relation("WorkflowRequestStepRecipient")
  request_actions                 Workflow_Request_Action[] @relation("WorkflowRequestActionActor")
  assets_owned                    Asset[]                  @relation("AssetOwner")
  assets_custodied                Asset[]                  @relation("AssetCustodian")
  assets_created                  Asset[]                  @relation("AssetCreatedBy")
  asset_relationships_created     Asset_Relationship[]     @relation("AssetRelationshipCreatedBy")
  asset_attestations              Asset_Attestation[]      @relation("AssetAttestedBy")
  asset_universe_links_created    Audit_Universe_Asset[]   @relation("AuditUniverseAssetCreatedBy")
  asset_engagement_links_created  Audit_Engagement_Asset[] @relation("AuditEngagementAssetCreatedBy")
  asset_finding_links_created     Audit_Finding_Asset[]    @relation("AuditFindingAssetCreatedBy")
  asset_risk_links_created        Risk_Asset_Link[]        @relation("RiskAssetLinkCreatedBy")
  asset_evidence_links_created    Audit_Evidence_Asset[]   @relation("AuditEvidenceAssetCreatedBy")
  notification_templates_created  Notification_Template[]  @relation("NotificationTemplateCreatedBy")
  notification_templates_updated  Notification_Template[]  @relation("NotificationTemplateUpdatedBy")
  working_paper_templates_created Working_Paper_Template[] @relation("WorkingPaperTemplateCreatedBy")
  working_paper_templates_updated Working_Paper_Template[] @relation("WorkingPaperTemplateUpdatedBy")
  report_templates_created        Report_Template[]        @relation("ReportTemplateCreatedBy")
  report_templates_updated        Report_Template[]        @relation("ReportTemplateUpdatedBy")
  system_configs_updated          System_Config[]          @relation("SystemConfigUpdatedBy")
  signatures                      User_Signature[]         @relation("UserSignatureOwner")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user_roles       User_Role[]
  role_permissions Role_Permission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  slug        String   @unique // e.g. "engagement:create", "finding:read"
  name        String // human-readable display name
  module      String // audit | risk | workflow | user | document | dashboard | messaging | logging | background | settings
  action      String // derived from slug, retained for query/sort compatibility
  description String // explains what this permission allows
  created_at  DateTime @default(now())

  role_permissions Role_Permission[]

  @@map("permissions")
}

model User_Role {
  id          String    @id @default(uuid())
  user_id     String
  role_id     String
  assigned_by String?
  assigned_at DateTime  @default(now())
  expires_at  DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
  @@map("user_roles")
}

model Role_Permission {
  id            String   @id @default(uuid())
  role_id       String
  permission_id String
  created_at    DateTime @default(now())

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@map("role_permissions")
}

model Refresh_Token {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  revoked_at DateTime?
  // Set to the successor token's id when this token is rotated out by a normal
  // refresh. Lets reuse-detection tell a benign concurrent refresh (e.g. two
  // browser tabs sharing one cookie) apart from a genuine stolen-token replay.
  replaced_by String?
  ip_address String?
  user_agent String?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Password_Reset_Token {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique // sha256 of the raw token emailed to the user
  expires_at DateTime
  used_at    DateTime?
  ip_address String?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("password_reset_tokens")
}

model Mfa_Backup_Code {
  id         String    @id @default(uuid())
  user_id    String
  code_hash  String // bcrypt hash of a single-use recovery code
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("mfa_backup_codes")
}

model Mfa_Email_Otp {
  id          String    @id @default(uuid())
  user_id     String
  code_hash   String // sha256 of the 6-digit code
  expires_at  DateTime
  consumed_at DateTime?
  attempts    Int       @default(0)
  created_at  DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("mfa_email_otps")
}

// ============================================================
// LOGGING MODULE
// ============================================================

model Audit_Log {
  id            String   @id @default(uuid())
  user_id       String?
  action        String
  module        String
  entity_type   String?
  entity_id     String?
  old_values    String? // JSON string
  new_values    String? // JSON string
  ip_address    String?
  user_agent    String?
  status        String   @default("success") // success | failure
  error_message String?
  duration_ms   Int?
  created_at    DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([module])
  @@index([created_at])
  @@index([module, created_at])
  @@map("audit_logs")
}

// ============================================================
// MESSAGING MODULE
// ============================================================

model Notification {
  id             String    @id @default(uuid())
  user_id        String
  title          String
  body           String
  type           String // info | warning | error | success
  channel        String // in_app | email | sms
  is_read        Boolean   @default(false)
  read_at        DateTime?
  reference_type String?
  reference_id   String?
  metadata       String? // JSON string
  created_at     DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@map("notifications")
}

model Email_Log {
  id           String    @id @default(uuid())
  to_address   String
  from_address String
  subject      String
  template     String?
  status       String    @default("pending") // pending | sent | failed | bounced
  error        String?
  sent_at      DateTime?
  created_at   DateTime  @default(now())

  @@map("email_logs")
}

model Notification_Queue {
  id           String    @id @default(uuid())
  type         String // email | in_app
  payload      String    @db.NVarChar(Max) // JSON string
  status       String    @default("pending") // pending | processing | sent | failed
  priority     Int       @default(0) // higher = drained first (e.g. OTP / password reset)
  attempts     Int       @default(0)
  max_attempts Int       @default(3)
  last_error   String?   @db.NVarChar(Max)
  scheduled_at DateTime  @default(now())
  processed_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([status, priority, scheduled_at])
  @@map("notification_queue")
}

model Notification_Template {
  id            String    @id @default(uuid())
  event_key     String // e.g. workflow.approval.created | audit.escalation.level_1
  channel       String // email | in_app
  name          String
  subject       String?
  body          String    @db.NVarChar(Max)
  description   String?
  is_active     Boolean   @default(true)
  created_by_id String?
  updated_by_id String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  created_by User? @relation("NotificationTemplateCreatedBy", fields: [created_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  updated_by User? @relation("NotificationTemplateUpdatedBy", fields: [updated_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([event_key, channel])
  @@index([event_key])
  @@index([channel])
  @@index([is_active])
  @@map("notification_templates")
}

// ============================================================
// DOCUMENT MODULE
// ============================================================

model Document {
  id               String    @id @default(uuid())
  uploaded_by_id   String
  original_name    String
  stored_name      String
  mime_type        String
  file_size        Int
  storage_path     String
  storage_provider String // local | azure_blob | aws_s3
  module           String
  entity_type      String?
  entity_id        String?
  version_number   Int       @default(1)
  deleted_at       DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  uploaded_by User                @relation(fields: [uploaded_by_id], references: [id])
  versions    Document_Version[]
  templates   Document_Template[]
  evidence    Audit_Evidence[]
  reports     Audit_Report[]
  working_paper_sources Audit_Working_Paper[] @relation("WorkingPaperSourceDocument")
  signature_uses     User_Signature[]                   @relation("UserSignatureImage")
  signed_doc_sources Workflow_Request_Signed_Document[] @relation("SignedDocSource")
  signed_doc_outputs Workflow_Request_Signed_Document[] @relation("SignedDocOutput")
  approval_signed_outputs Workflow_Approval_Signed_Document[] @relation("ApprovalSignedDocOutput")

  @@index([entity_type, entity_id])
  @@map("documents")
}

model Document_Version {
  id               String   @id @default(uuid())
  document_id      String
  version_number   Int
  uploaded_by_id   String
  original_name    String
  stored_name      String
  mime_type        String
  file_size        Int
  storage_path     String
  storage_provider String // local | azure_blob | aws_s3
  change_note      String?
  created_at       DateTime @default(now())

  document    Document @relation(fields: [document_id], references: [id])
  uploaded_by User     @relation(fields: [uploaded_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([document_id, version_number])
  @@index([document_id])
  @@map("document_versions")
}

model Document_Template {
  id            String    @id @default(uuid())
  name          String    @unique
  description   String?
  category      String // working_paper | audit_report | finding | risk_assessment | checklist | policy | procedure
  content       String?   @db.NVarChar(Max) // HTML / markdown / plaintext body (nullable if linked to a binary template via document_id)
  document_id   String?
  metadata      String? // JSON string — placeholders / field definitions
  is_active     Boolean   @default(true)
  created_by_id String
  updated_by_id String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  document   Document? @relation(fields: [document_id], references: [id])
  created_by User      @relation("TemplateCreatedBy", fields: [created_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  updated_by User?     @relation("TemplateUpdatedBy", fields: [updated_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([category])
  @@index([is_active])
  @@map("document_templates")
}

// ============================================================
// ASSET MODULE
//
// SQL Server does not support native enums, so all enum-like
// fields below are modelled as String and mirrored in
// src/modules/asset/domain/enum/asset.enum.ts.
// ============================================================

model Asset {
  id                     String    @id @default(uuid())
  asset_tag              String    @unique
  name                   String
  description            String?   @db.NVarChar(Max)
  asset_type             String
  category               String?
  status                 String    @default("active")
  lifecycle_state        String    @default("active")
  criticality            String    @default("medium")
  data_classification    String    @default("internal")
  confidentiality_rating String    @default("medium")
  integrity_rating       String    @default("medium")
  availability_rating    String    @default("medium")
  owner_id               String
  custodian_id           String?
  department             String?
  location               String?
  environment            String?
  hostname               String?
  ip_address             String?
  serial_number          String?
  manufacturer           String?
  model                  String?
  os_name                String?
  os_version             String?
  supplier               String?
  source_system          String    @default("manual")
  source_id              String?
  last_seen_at           DateTime?
  last_attested_at       DateTime?
  metadata               String?   @db.NVarChar(Max)
  created_by_id          String
  deleted_at             DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  owner              User                       @relation("AssetOwner", fields: [owner_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  custodian          User?                      @relation("AssetCustodian", fields: [custodian_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  created_by         User                       @relation("AssetCreatedBy", fields: [created_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  relationships_from Asset_Relationship[]       @relation("AssetRelationshipSource")
  relationships_to   Asset_Relationship[]       @relation("AssetRelationshipTarget")
  attestations       Asset_Attestation[]
  sources            Asset_Source[]
  universe_links     Audit_Universe_Asset[]
  engagement_links   Audit_Engagement_Asset[]
  finding_links      Audit_Finding_Asset[]
  risk_links         Risk_Asset_Link[]
  evidence_links     Audit_Evidence_Asset[]

  @@index([asset_type])
  @@index([status])
  @@index([lifecycle_state])
  @@index([criticality])
  @@index([data_classification])
  @@index([owner_id])
  @@index([custodian_id])
  @@index([department])
  @@index([environment])
  @@index([source_system])
  @@index([last_seen_at])
  @@index([last_attested_at])
  @@map("assets")
}

model Asset_Relationship {
  id                String   @id @default(uuid())
  source_asset_id   String
  target_asset_id   String
  relationship_type String
  description       String?  @db.NVarChar(Max)
  created_by_id     String
  created_at        DateTime @default(now())

  source_asset Asset @relation("AssetRelationshipSource", fields: [source_asset_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  target_asset Asset @relation("AssetRelationshipTarget", fields: [target_asset_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  created_by   User  @relation("AssetRelationshipCreatedBy", fields: [created_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([source_asset_id, target_asset_id, relationship_type])
  @@index([source_asset_id])
  @@index([target_asset_id])
  @@index([relationship_type])
  @@map("asset_relationships")
}

model Asset_Attestation {
  id             String   @id @default(uuid())
  asset_id       String
  attested_by_id String
  status         String   @default("confirmed") // confirmed | changes_required | rejected
  notes          String?  @db.NVarChar(Max)
  snapshot       String   @db.NVarChar(Max)
  attested_at    DateTime @default(now())
  created_at     DateTime @default(now())

  asset       Asset @relation(fields: [asset_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  attested_by User  @relation("AssetAttestedBy", fields: [attested_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([asset_id])
  @@index([attested_by_id])
  @@index([status])
  @@index([attested_at])
  @@map("asset_attestations")
}

model Asset_Source {
  id             String    @id @default(uuid())
  asset_id       String
  source_system  String
  source_id      String
  sync_status    String    @default("synced") // synced | pending | failed | stale
  last_synced_at DateTime?
  raw_payload    String?   @db.NVarChar(Max)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  asset Asset @relation(fields: [asset_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([source_system, source_id])
  @@index([asset_id])
  @@index([source_system])
  @@index([sync_status])
  @@index([last_synced_at])
  @@map("asset_sources")
}

model Audit_Universe_Asset {
  id            String   @id @default(uuid())
  universe_id   String
  asset_id      String
  created_by_id String
  created_at    DateTime @default(now())

  universe   Audit_Universe @relation(fields: [universe_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  asset      Asset          @relation(fields: [asset_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  created_by User           @relation("AuditUniverseAssetCreatedBy", fields: [created_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([universe_id, asset_id])
  @@index([universe_id])
  @@index([asset_id])
  @@index([created_by_id])
  @@map("audit_universe_assets")
}

model Audit_Engagement_Asset {
  id            String   @id @default(uuid())
  engagement_id String
  asset_id      String
  scope_role    String   @default("primary") // primary | supporting | dependency | excluded_reference
  scope_reason  String?  @db.NVarChar(Max)
  created_by_id String
  created_at    DateTime @default(now())

  engagement Audit_Engagement @relation(fields: [engagement_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  asset      Asset            @relation(fields: [asset_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  created_by User             @relation("AuditEngagementAssetCreatedBy", fields: [created_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([engagement_id, asset_id])
  @@index([engagement_id])
  @@index([asset_id])
  @@index([scope_role])
  @@index([created_by_id])
  @@map("audit_engagement_assets")
}

model Audit_Finding_Asset {
  id             String   @id @default(uuid())
  finding_id     String
  asset_id       String
  impact_summary String?  @db.NVarChar(Max)
  created_by_id  String
  created_at     DateTime @default(now())

  finding    Audit_Finding @relation(fields: [finding_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  asset      Asset         @relation(fields: [asset_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  created_by User          @relation("AuditFindingAssetCreatedBy", fields: [created_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([finding_id, asset_id])
  @@index([finding_id])
  @@index([asset_id])
  @@index([created_by_id])
  @@map("audit_finding_assets")
}

model Risk_Asset_Link {
  id            String   @id @default(uuid())
  risk_id       String
  asset_id      String
  link_reason   String?  @db.NVarChar(Max)
  created_by_id String
  created_at    DateTime @default(now())

  risk       Risk_Register @relation(fields: [risk_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  asset      Asset         @relation(fields: [asset_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  created_by User          @relation("RiskAssetLinkCreatedBy", fields: [created_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([risk_id, asset_id])
  @@index([risk_id])
  @@index([asset_id])
  @@index([created_by_id])
  @@map("risk_asset_links")
}

model Audit_Evidence_Asset {
  id            String   @id @default(uuid())
  evidence_id   String
  asset_id      String
  created_by_id String
  created_at    DateTime @default(now())

  evidence   Audit_Evidence @relation(fields: [evidence_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  asset      Asset          @relation(fields: [asset_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  created_by User           @relation("AuditEvidenceAssetCreatedBy", fields: [created_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([evidence_id, asset_id])
  @@index([evidence_id])
  @@index([asset_id])
  @@index([created_by_id])
  @@map("audit_evidence_assets")
}

// ============================================================
// BACKGROUND SERVICE MODULE
// ============================================================

model Scheduled_Job {
  id              String    @id @default(uuid())
  job_key         String    @unique // e.g. "BG:AUDIT:REMINDER:DAILY"
  name            String
  description     String?
  cron_expression String
  is_active       Boolean   @default(true)
  last_run_at     DateTime?
  next_run_at     DateTime?
  last_status     String? // success | failure | running
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  job_runs Scheduled_Job_Run[]

  @@map("scheduled_jobs")
}

model Scheduled_Job_Run {
  id           String    @id @default(uuid())
  job_id       String
  status       String // running | success | failure
  started_at   DateTime  @default(now())
  completed_at DateTime?
  error        String?
  metadata     String? // JSON string

  scheduled_job Scheduled_Job @relation(fields: [job_id], references: [id])

  @@map("scheduled_job_runs")
}

// ============================================================
// AUDIT MODULE
//
// SQL Server does not support native enums, so all enum-like
// fields below are modelled as String and mirrored in
// src/modules/audit/domain/enum/audit.enum.ts for compile-time
// safety. Allowed values are listed inline next to each field.
//
//   audit_type        : it | financial | compliance | systems
//   priority          : critical | high | medium | low
//   audit_frequency   : annual | biannual | quarterly | monthly
//   universe_category : department | system | process | asset | project
//   universe_status   : active | inactive
//   plan_status       : draft | submitted | approved | rejected
//   engagement_status : planned | in_progress | under_review | reported | closed
//   wp_status         : draft | submitted | approved | rejected
//   finding_category  : it | financial | compliance | operational
//   finding_severity  : critical | high | medium | low | informational
//   finding_status    : open | management_response_received | in_remediation | verified | closed
//   report_status     : draft | submitted | approved | issued
//   verification      : pending | verified | rejected
//   checklist_result  : passed | failed | not_applicable | not_tested
// ============================================================

model Audit_Universe {
  id              String    @id @default(uuid())
  name            String
  description     String?   @db.NVarChar(Max)
  category        String // department | system | process | asset | project
  owner_id        String
  risk_score      Decimal?  @db.Decimal(5, 2)
  last_audited_at DateTime?
  audit_frequency String // annual | biannual | quarterly | monthly
  status          String    @default("active") // active | inactive
  created_by_id   String
  deleted_at      DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  owner       User               @relation("UniverseOwner", fields: [owner_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  created_by  User               @relation("UniverseCreatedBy", fields: [created_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  plan_items  Audit_Plan_Item[]
  engagements Audit_Engagement[]
  risks       Risk_Register[]
  asset_links Audit_Universe_Asset[]

  @@index([category])
  @@index([status])
  @@index([owner_id])
  @@index([risk_score])
  @@map("audit_universe")
}

model Audit_Plan {
  id               String    @id @default(uuid())
  title            String
  year             Int
  description      String?   @db.NVarChar(Max)
  status           String    @default("draft") // draft | submitted | approved | rejected
  created_by_id    String
  approved_by_id   String?
  approved_at      DateTime?
  rejection_reason String?   @db.NVarChar(Max)
  deleted_at       DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  created_by  User              @relation("PlanCreatedBy", fields: [created_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  approved_by User?             @relation("PlanApprovedBy", fields: [approved_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  items       Audit_Plan_Item[]

  @@index([status])
  @@index([year])
  @@index([created_by_id])
  @@map("audit_plans")
}

model Audit_Plan_Item {
  id                 String   @id @default(uuid())
  plan_id            String
  universe_id        String
  audit_type         String // it | financial | compliance | systems
  planned_start_date DateTime
  planned_end_date   DateTime
  priority           String // critical | high | medium | low
  engagement_created Boolean  @default(false)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  plan        Audit_Plan         @relation(fields: [plan_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  universe    Audit_Universe     @relation(fields: [universe_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  engagements Audit_Engagement[]

  @@index([plan_id])
  @@index([universe_id])
  @@index([audit_type])
  @@index([priority])
  @@map("audit_plan_items")
}

model Audit_Engagement {
  id                 String    @id @default(uuid())
  reference_number   String    @unique
  title              String
  universe_id        String
  plan_item_id       String?
  audit_type         String // it | financial | compliance | systems
  status             String    @default("planned") // planned | in_progress | under_review | reported | closed
  priority           String // critical | high | medium | low
  lead_auditor_id    String
  audit_manager_id   String
  auditee_id         String
  planned_start_date DateTime
  planned_end_date   DateTime
  actual_start_date  DateTime?
  actual_end_date    DateTime?
  sla_deadline       DateTime
  is_adhoc           Boolean   @default(false)
  adhoc_reason       String?   @db.NVarChar(Max)
  // Optional per-engagement checklist control set chosen at creation, as a JSON
  // array of { controlReference, controlDescription, testProcedure }. When set,
  // populateChecklists uses this instead of the global per-audit-type template.
  checklist_template String?   @db.NVarChar(Max)
  created_by_id      String
  deleted_at         DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  universe             Audit_Universe        @relation(fields: [universe_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  plan_item            Audit_Plan_Item?      @relation(fields: [plan_item_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  lead_auditor         User                  @relation("EngagementLead", fields: [lead_auditor_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  audit_manager        User                  @relation("EngagementManager", fields: [audit_manager_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  auditee              User                  @relation("EngagementAuditee", fields: [auditee_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  created_by           User                  @relation("EngagementCreatedBy", fields: [created_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  working_papers       Audit_Working_Paper[]
  evidence             Audit_Evidence[]
  findings             Audit_Finding[]
  report               Audit_Report?
  checklists           Audit_Checklist[]
  workflow_assignments Workflow_Assignment[]
  asset_links          Audit_Engagement_Asset[]

  @@index([status])
  @@index([audit_type])
  @@index([lead_auditor_id])
  @@index([audit_manager_id])
  @@index([auditee_id])
  @@index([sla_deadline])
  @@index([reference_number])
  @@map("audit_engagements")
}

model Audit_Working_Paper {
  id               String    @id @default(uuid())
  engagement_id    String
  template_id       String?
  source_document_id String?
  working_paper_type String   @default("general")
  title            String
  content          String    @db.NVarChar(Max)
  version_number   Int       @default(1)
  status           String    @default("draft") // draft | submitted | approved | rejected
  created_by_id    String
  reviewed_by_id   String?
  rejection_reason String?   @db.NVarChar(Max)
  import_metadata  String?   @db.NVarChar(Max)
  deleted_at       DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  engagement  Audit_Engagement @relation(fields: [engagement_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  template    Working_Paper_Template? @relation(fields: [template_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  source_document Document?        @relation("WorkingPaperSourceDocument", fields: [source_document_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  created_by  User             @relation("WorkingPaperCreatedBy", fields: [created_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  reviewed_by User?            @relation("WorkingPaperReviewedBy", fields: [reviewed_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  evidence    Audit_Evidence[]
  findings    Audit_Finding[]

  @@index([engagement_id])
  @@index([template_id])
  @@index([source_document_id])
  @@index([working_paper_type])
  @@index([status])
  @@index([created_by_id])
  @@map("audit_working_papers")
}

model Audit_Evidence {
  id               String   @id @default(uuid())
  engagement_id    String
  working_paper_id String?
  finding_id       String?
  document_id      String
  file_name        String
  file_type        String
  uploaded_by_id   String
  is_disputed      Boolean  @default(false)
  dispute_reason   String?  @db.NVarChar(Max)
  uploaded_at      DateTime @default(now())
  created_at       DateTime @default(now())

  engagement    Audit_Engagement     @relation(fields: [engagement_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  working_paper Audit_Working_Paper? @relation(fields: [working_paper_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  finding       Audit_Finding?       @relation(fields: [finding_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  document      Document             @relation(fields: [document_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  uploaded_by   User                 @relation("EvidenceUploadedBy", fields: [uploaded_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  remediations  Audit_Follow_Up[]    @relation("FollowUpRemediationEvidence")
  checklists    Audit_Checklist[]
  asset_links   Audit_Evidence_Asset[]

  @@index([engagement_id])
  @@index([working_paper_id])
  @@index([finding_id])
  @@index([uploaded_by_id])
  @@map("audit_evidence")
}

model Audit_Finding {
  id               String    @id @default(uuid())
  engagement_id    String
  working_paper_id String?
  checklist_id     String? // failed control test this finding was raised against (the "criteria")
  risk_id          String? // links the finding into the risk register (feedback loop)
  title            String
  description      String    @db.NVarChar(Max)
  category         String // it | financial | compliance | operational
  severity         String // critical | high | medium | low | informational
  root_cause       String    @db.NVarChar(Max)
  risk_implication String    @db.NVarChar(Max)
  recommendation   String    @db.NVarChar(Max)
  auditee_id       String
  status           String    @default("open") // open | management_response_received | in_remediation | verified | pending_closure | closed
  due_date         DateTime
  created_by_id    String
  closed_by_id     String?
  closed_at        DateTime?
  deleted_at       DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  engagement    Audit_Engagement     @relation(fields: [engagement_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  working_paper Audit_Working_Paper? @relation(fields: [working_paper_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  checklist     Audit_Checklist?     @relation(fields: [checklist_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  risk          Risk_Register?       @relation("RiskFindings", fields: [risk_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  auditee       User                 @relation("FindingAuditee", fields: [auditee_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  created_by    User                 @relation("FindingCreatedBy", fields: [created_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  closed_by     User?                @relation("FindingClosedBy", fields: [closed_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  evidence      Audit_Evidence[]
  follow_up     Audit_Follow_Up?
  asset_links   Audit_Finding_Asset[]

  @@index([engagement_id])
  @@index([severity])
  @@index([status])
  @@index([auditee_id])
  @@index([due_date])
  @@index([category])
  @@index([checklist_id])
  @@index([risk_id])
  @@map("audit_findings")
}

model Audit_Report {
  id                String    @id @default(uuid())
  engagement_id     String    @unique
  title             String
  executive_summary String    @db.NVarChar(Max)
  scope             String    @db.NVarChar(Max)
  methodology       String    @db.NVarChar(Max)
  status            String    @default("draft") // draft | submitted | approved | issued
  version_number    Int       @default(1)
  document_id       String?
  issued_at         DateTime?
  rejection_reason  String?   @db.NVarChar(Max)
  template_id       String?
  created_by_id     String
  deleted_at        DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  engagement Audit_Engagement @relation(fields: [engagement_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  document   Document?        @relation(fields: [document_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  created_by User             @relation("ReportCreatedBy", fields: [created_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([engagement_id])
  @@index([status])
  @@index([created_by_id])
  @@index([template_id])
  @@map("audit_reports")
}

model Audit_Follow_Up {
  id                        String    @id @default(uuid())
  finding_id                String    @unique
  management_response       String?   @db.NVarChar(Max)
  management_response_by_id String?
  management_response_at    DateTime?
  remediation_evidence_id   String?
  verification_status       String    @default("pending") // pending | verified | rejected
  verified_by_id            String?
  verified_at               DateTime?
  verification_notes        String?   @db.NVarChar(Max)
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  finding                Audit_Finding   @relation(fields: [finding_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  management_response_by User?           @relation("FollowUpResponseBy", fields: [management_response_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  remediation_evidence   Audit_Evidence? @relation("FollowUpRemediationEvidence", fields: [remediation_evidence_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  verified_by            User?           @relation("FollowUpVerifiedBy", fields: [verified_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([finding_id])
  @@index([verification_status])
  @@map("audit_follow_ups")
}

model Audit_Checklist {
  id                  String    @id @default(uuid())
  engagement_id       String
  audit_type          String // it | financial | compliance | systems
  control_reference   String
  control_description String    @db.NVarChar(Max)
  test_procedure      String    @db.NVarChar(Max)
  result              String    @default("not_tested") // passed | failed | not_applicable | not_tested
  notes               String?   @db.NVarChar(Max)
  evidence_id         String?
  tested_by_id        String?
  tested_at           DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  engagement Audit_Engagement @relation(fields: [engagement_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  evidence   Audit_Evidence?  @relation(fields: [evidence_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  tested_by  User?            @relation("ChecklistTestedBy", fields: [tested_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  findings   Audit_Finding[]

  @@index([engagement_id])
  @@index([audit_type])
  @@index([result])
  @@map("audit_checklists")
}

// ============================================================
// RISK MODULE
//
// SQL Server does not support native enums, so all enum-like
// fields below are modelled as String and mirrored in
// src/modules/risk/domain/enum/risk.enum.ts for compile-time
// safety. Allowed values are listed inline next to each field.
//
//   risk_status : open | mitigated | accepted | closed
//   score bands : low (1-5) | medium (6-12) | high (13-19) | critical (20-25)
// ============================================================

model Risk_Category {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?
  is_active     Boolean  @default(true)
  created_by_id String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  created_by User            @relation("RiskCategoryCreatedBy", fields: [created_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  risks      Risk_Register[]

  @@map("risk_categories")
}

model Risk_Register {
  id               String    @id @default(uuid())
  title            String
  description      String    @db.NVarChar(Max)
  category_id      String
  owner_id         String
  likelihood       Int
  impact           Int
  current_score    Int
  status           String    @default("open") // open | mitigated | accepted | closed
  last_assessed_at DateTime?
  universe_id      String?
  created_by_id    String
  deleted_at       DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  category    Risk_Category     @relation(fields: [category_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  owner       User              @relation("RiskOwner", fields: [owner_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  universe    Audit_Universe?   @relation(fields: [universe_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  created_by  User              @relation("RiskCreatedBy", fields: [created_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  assessments   Risk_Assessment[]
  asset_links   Risk_Asset_Link[]
  findings      Audit_Finding[]           @relation("RiskFindings")
  control_links Compliance_Control_Risk[]

  @@index([category_id])
  @@index([owner_id])
  @@index([status])
  @@index([current_score])
  @@index([universe_id])
  @@map("risk_register")
}

model Risk_Assessment {
  id             String   @id @default(uuid())
  risk_id        String
  likelihood     Int
  impact         Int
  score          Int
  notes          String?  @db.NVarChar(Max)
  assessed_by_id String
  assessed_at    DateTime @default(now())
  created_at     DateTime @default(now())

  risk        Risk_Register @relation(fields: [risk_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  assessed_by User          @relation("RiskAssessedBy", fields: [assessed_by_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([risk_id])
  @@index([assessed_by_id])
  @@index([assessed_at])
  @@index([score])
  @@map("risk_assessments")
}

// ============================================================
// WORKFLOW MODULE
//
// SQL Server does not support native enums, so all enum-like
// fields below are modelled as String and mirrored in
// src/modules/workflow/domain/enum/workflow.enum.ts.
//
//   workflow_entity_type      : audit_plan | audit_working_paper | audit_report
//   workflow_approval_status  : pending | approved | rejected | cancelled
//   workflow_step_status      : pending | approved | rejected
//   workflow_assignment_role  : lead_auditor | supporting_auditor
//   escalation_entity_type    : audit_engagement | workflow_approval
//   escalation_reason         : sla_breach | approval_inaction
//   escalation_policy_type    : it | financial | compliance | systems | all
// ============================================================

model Workflow_Approval {
  id               String    @id @default(uuid())
  entity_type      String // audit_plan | audit_working_paper | audit_report
  entity_id        String
  submitted_by_id  String
  current_level    Int       @default(1)
  status           String    @default("pending") // pending | approved | rejected | cancelled
  rejection_reason String?   @db.NVarChar(Max)
  completed_at     DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  submitted_by     User                                @relation("WorkflowApprovalSubmittedBy", fields: [submitted_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  steps            Workflow_Approval_Step[]
  signed_documents Workflow_Approval_Signed_Document[] @relation("ApprovalSignedDocs")

  @@index([entity_type])
  @@index([entity_id])
  @@index([status])
  @@index([submitted_by_id])
  @@map("workflow_approvals")
}

model Workflow_Approval_Step {
  id                  String    @id @default(uuid())
  approval_id         String
  level               Int
  // Null until someone acts on a permission-pool level; pinned up-front only for
  // engagement-manager levels. On action it records who actually approved/rejected.
  approver_id         String?
  // Permission a user must hold to act on this level. Null only for legacy rows.
  required_permission String?
  status              String    @default("pending") // pending | approved | rejected
  comment             String?   @db.NVarChar(Max)
  acted_at            DateTime?
  signature_id        String? // FK -> user_signatures.id, set on approve when the approver has a signature
  created_at          DateTime  @default(now())

  approval  Workflow_Approval @relation(fields: [approval_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approver  User?             @relation("WorkflowApprovalStepApprover", fields: [approver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  signature User_Signature?   @relation("ApprovalStepSignature", fields: [signature_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([approval_id])
  @@index([approver_id])
  @@index([required_permission])
  @@index([status])
  @@index([level])
  @@map("workflow_approval_steps")
}

model Workflow_Approval_Signed_Document {
  id                 String   @id @default(uuid())
  approval_id        String
  signed_document_id String
  generated_at       DateTime @default(now())

  approval        Workflow_Approval @relation("ApprovalSignedDocs", fields: [approval_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  signed_document Document          @relation("ApprovalSignedDocOutput", fields: [signed_document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([approval_id])
  @@map("workflow_approval_signed_documents")
}

model Workflow_Assignment {
  id             String   @id @default(uuid())
  engagement_id  String
  user_id        String
  role           String // lead_auditor | supporting_auditor
  assigned_by_id String
  assigned_at    DateTime @default(now())
  created_at     DateTime @default(now())

  engagement  Audit_Engagement @relation(fields: [engagement_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user        User             @relation("WorkflowAssignmentUser", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assigned_by User             @relation("WorkflowAssignmentAssignedBy", fields: [assigned_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([engagement_id])
  @@index([user_id])
  @@index([role])
  @@map("workflow_assignments")
}

model Workflow_Escalation {
  id               String    @id @default(uuid())
  entity_type      String // audit_engagement | workflow_approval
  entity_id        String
  escalation_level Int
  escalated_to_id  String
  reason           String // sla_breach | approval_inaction
  notified_at      DateTime  @default(now())
  acknowledged_at  DateTime?
  created_at       DateTime  @default(now())

  escalated_to User @relation("WorkflowEscalationEscalatedTo", fields: [escalated_to_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entity_type])
  @@index([entity_id])
  @@index([entity_type, entity_id])
  @@index([escalation_level])
  @@index([escalation_level, notified_at])
  @@index([escalated_to_id])
  @@map("workflow_escalations")
}

model Escalation_Policy {
  id            String   @id @default(uuid())
  audit_type    String   @unique // it | financial | compliance | systems | all
  level_1_hours Int      @default(24)
  level_2_hours Int      @default(72)
  level_3_hours Int      @default(120)
  level_4_hours Int      @default(168)
  is_active     Boolean  @default(true)
  created_by_id String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  created_by User @relation("EscalationPolicyCreatedBy", fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([audit_type])
  @@index([is_active])
  @@map("escalation_policies")
}

// ============================================================
// WORKFLOW — AD-HOC REQUESTS
//
// User-initiated, general-purpose sequential approval/sign-off.
// Decoupled from the audit-specific Workflow_Approval engine.
//
//   request_status      : pending | completed | rejected | cancelled
//   request_step_status : pending | approved | signed | rejected
//   request_action_type : approve | reject | sign | comment
//
// Attachments reuse the Document model
// (module='workflow', entity_type='workflow_request', entity_id=request.id).
// ============================================================

model Workflow_Request {
  id               String    @id @default(uuid())
  reference_number String    @unique // REQ-<year>-<seq>
  title            String
  description      String?   @db.NVarChar(Max)
  initiator_id     String
  current_level    Int       @default(1)
  status           String    @default("pending") // pending | completed | rejected | cancelled
  locked_at        DateTime? // set on first recipient action; content frozen thereafter
  deleted_at       DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  initiator        User                               @relation("WorkflowRequestInitiator", fields: [initiator_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  steps            Workflow_Request_Step[]
  actions          Workflow_Request_Action[]
  signed_documents Workflow_Request_Signed_Document[] @relation("RequestSignedDocs")

  @@index([initiator_id])
  @@index([status])
  @@index([reference_number])
  @@map("workflow_requests")
}

model Workflow_Request_Step {
  id           String    @id @default(uuid())
  request_id   String
  level        Int
  recipient_id String
  status       String    @default("pending") // pending | approved | signed | rejected
  acted_at     DateTime?
  created_at   DateTime  @default(now())

  request   Workflow_Request          @relation(fields: [request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipient User                      @relation("WorkflowRequestStepRecipient", fields: [recipient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actions   Workflow_Request_Action[]

  @@unique([request_id, level])
  @@index([request_id])
  @@index([recipient_id])
  @@index([status])
  @@map("workflow_request_steps")
}

model Workflow_Request_Action {
  id                 String   @id @default(uuid())
  request_id         String
  step_id            String?
  actor_id           String
  action_type        String // approve | reject | sign | comment
  comment            String?  @db.NVarChar(Max)
  signature_hash     String? // SHA-256 hex, set only when action_type = sign
  signature_manifest String?  @db.NVarChar(Max) // canonical JSON that was hashed
  signature_id       String? // FK -> user_signatures.id, set only when action_type = sign
  created_at         DateTime @default(now())

  request   Workflow_Request       @relation(fields: [request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  step      Workflow_Request_Step? @relation(fields: [step_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor     User                   @relation("WorkflowRequestActionActor", fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  signature User_Signature?        @relation("ActionSignature", fields: [signature_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([request_id])
  @@index([step_id])
  @@index([actor_id])
  @@index([action_type])
  @@map("workflow_request_actions")
}

model User_Signature {
  id          String    @id @default(uuid())
  user_id     String
  document_id String
  kind        String // drawn | uploaded
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  user     User     @relation("UserSignatureOwner", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  document Document @relation("UserSignatureImage", fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actions        Workflow_Request_Action[]  @relation("ActionSignature")
  approval_steps Workflow_Approval_Step[]   @relation("ApprovalStepSignature")

  @@index([user_id])
  @@map("user_signatures")
}

model Workflow_Request_Signed_Document {
  id                 String   @id @default(uuid())
  request_id         String
  source_document_id String? // null = standalone certificate
  signed_document_id String
  generated_at       DateTime @default(now())

  request         Workflow_Request @relation("RequestSignedDocs", fields: [request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source_document Document?        @relation("SignedDocSource", fields: [source_document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  signed_document Document         @relation("SignedDocOutput", fields: [signed_document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([request_id])
  @@map("workflow_request_signed_documents")
}

// ============================================================
// SETTINGS MODULE
//
// Template JSON shapes are validated in
// src/modules/settings/dto/request/settings.request.dto.ts.
//
//   settings_audit_type : it | financial | compliance | systems | all
// ============================================================

model Working_Paper_Template {
  id            String    @id @default(uuid())
  name          String    @unique
  description   String?
  audit_type    String // it | financial | compliance | systems | all
  sections      String    @db.NVarChar(Max)
  is_active     Boolean   @default(true)
  is_default    Boolean   @default(false)
  created_by_id String?
  updated_by_id String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  created_by User? @relation("WorkingPaperTemplateCreatedBy", fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updated_by User? @relation("WorkingPaperTemplateUpdatedBy", fields: [updated_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  working_papers Audit_Working_Paper[]

  @@index([audit_type])
  @@index([is_active])
  @@index([is_default])
  @@map("working_paper_templates")
}

model Report_Template {
  id                  String    @id @default(uuid())
  name                String    @unique
  description         String?
  sections            String    @db.NVarChar(Max)
  header_config       String?   @db.NVarChar(Max)
  footer_config       String?   @db.NVarChar(Max)
  signature_config    String?   @db.NVarChar(Max)
  available_variables String    @db.NVarChar(Max)
  is_active           Boolean   @default(true)
  is_default          Boolean   @default(false)
  created_by_id       String?
  updated_by_id       String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  created_by User? @relation("ReportTemplateCreatedBy", fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updated_by User? @relation("ReportTemplateUpdatedBy", fields: [updated_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([is_active])
  @@index([is_default])
  @@map("report_templates")
}

// ============================================================
// Compliance framework library — structured control catalogue.
// Frameworks (ISO 27001, PCI DSS, NIST, NDPR, …) own controls that
// engagements draw on. Replaces the flat checklist_templates JSON as the
// authoritative, GBB-editable source for control coverage reporting.
//
//   framework.category : it | financial | compliance | systems | governance
//   control.audit_type : it | financial | compliance | systems
// ============================================================
model Compliance_Framework {
  id          String    @id @default(uuid())
  code        String    @unique // ISO27001 | PCIDSS | NIST-CSF | NDPR | ...
  name        String
  description String?   @db.NVarChar(Max)
  category    String
  is_active   Boolean   @default(true)
  created_by_id String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  controls Compliance_Control[]

  @@index([is_active])
  @@map("compliance_frameworks")
}

model Compliance_Control {
  id                  String    @id @default(uuid())
  framework_id        String
  control_reference   String
  control_description String    @db.NVarChar(Max)
  test_procedure      String    @db.NVarChar(Max)
  audit_type          String // it | financial | compliance | systems
  is_active           Boolean   @default(true)
  created_by_id       String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  framework  Compliance_Framework      @relation(fields: [framework_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  risk_links Compliance_Control_Risk[]

  @@unique([framework_id, control_reference])
  @@index([framework_id])
  @@index([audit_type])
  @@index([is_active])
  @@map("compliance_controls")
}

// Maps a control to the risk(s) it mitigates (ISO 31000 / COBIT control–risk
// linkage), enabling risk-based assurance: which register risks have control
// coverage, and how much of it has been tested.
model Compliance_Control_Risk {
  id            String   @id @default(uuid())
  control_id    String
  risk_id       String
  created_by_id String?
  created_at    DateTime @default(now())

  control Compliance_Control @relation(fields: [control_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  risk    Risk_Register      @relation(fields: [risk_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([control_id, risk_id])
  @@index([control_id])
  @@index([risk_id])
  @@map("compliance_control_risks")
}

model System_Config {
  id            String   @id @default(uuid())
  key           String   @unique
  value         String?  @db.NVarChar(Max)
  description   String?
  is_public     Boolean  @default(false)
  updated_by_id String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  updated_by User? @relation("SystemConfigUpdatedBy", fields: [updated_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("system_config")
}
